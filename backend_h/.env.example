# Contact details for scholarly metadata / Unpaywall requests.
UNPAYWALL_EMAIL=you@example.com
CONTACT_EMAIL=you@example.com

# Optional PDF parser service; leave blank to use PyMuPDF.
GROBID_URL=
GROBID_TIMEOUT_SECONDS=90

# Network and PDF limits.
HTTP_TIMEOUT_SECONDS=30
MAX_PDF_MB=50

# Offline lexical relationship cutoffs. Scores are heuristics, not probabilities.
OFFLINE_RELATIONSHIP_FOCUS_THRESHOLD=0.09
OFFLINE_RELATIONSHIP_METHOD_THRESHOLD=0.12
OFFLINE_RELATIONSHIP_GAP_THRESHOLD=0.10
OFFLINE_RELATIONSHIP_GAP_ADDRESS_THRESHOLD=0.10
OFFLINE_RELATIONSHIP_CONFLICT_THRESHOLD=0.12
